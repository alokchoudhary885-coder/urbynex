# ── Urbynex Environment Configuration ───────────────────────────────────────
# Copy this file to .env or .env.local for local overrides.

# FastAPI Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Authentication & Security
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Redis / Celery Task Broker
# When Redis is available, async simulations run on separate Celery worker processes.
# When unavailable, the backend gracefully falls back to FastAPI BackgroundTasks.
REDIS_URL=redis://localhost:6379/0

# Database
DATABASE_PATH=backend/db/urbynex.db

# Live Traffic Feeds (Optional — Zero-Fabrication Policy)
# If empty, providers are reported as 'credentials_missing' rather than fabricating fake telemetry.
TOMTOM_API_KEY=
GOOGLE_ROUTES_API_KEY=
HERE_API_KEY=
INRIX_API_KEY=

# AI Copilot & Gemini API (Optional)
# If empty, the Copilot falls back to the local BM25 + deterministic RAG retriever.
GEMINI_API_KEY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
